<?xml version="1.0" encoding="utf-8"?>
<!-- dasio#207 a process's output loop at a moment you cannot plan: who runs, waits and wakes on every CPU,
     kept in memory (no trace file IO while it records). 512 x 1024 KB: about 14 s back on a 32-CPU DAW PC.
     wpr -start <this file>!DasioCsw    then    wpr -stop <out.etl> -skipPdbGen
     Cut the moment out with etl-cut.ps1. -->
<WindowsPerformanceRecorder Version="1.0" Author="dasio" Comments="dasio#207 audio thread at the loop">
  <Profiles>
    <SystemCollector Id="DasioCswCollector" Name="NT Kernel Logger">
      <BufferSize Value="1024" />
      <Buffers Value="512" />
    </SystemCollector>
    <SystemProvider Id="DasioCswProvider">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="CSwitch" />
        <Keyword Value="ReadyThread" />
        <Keyword Value="SampledProfile" />
        <Keyword Value="Interrupt" />
        <Keyword Value="DPC" />
      </Keywords>
    </SystemProvider>
    <Profile Id="DasioCsw.Verbose.Memory" Name="DasioCsw" Description="dasio#207: context switches, wake-ups, 1 ms samples, ISR and DPC" LoggingMode="Memory" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="DasioCswCollector">
          <SystemProviderId Value="DasioCswProvider" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
